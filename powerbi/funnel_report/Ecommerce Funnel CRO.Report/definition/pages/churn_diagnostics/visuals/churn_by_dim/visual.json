{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "churn_by_dim",
  "position": {
    "x": 50,
    "y": 380,
    "z": 1,
    "height": 250,
    "width": 440,
    "tabOrder": 1
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "funnel_wide_export"
                    }
                  },
                  "Property": "ReferralSource"
                }
              },
              "queryRef": "funnel_wide_export.ReferralSource",
              "nativeQueryRef": "ReferralSource",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "funnel_wide_export"
                    }
                  },
                  "Property": "is_purchased"
                }
              },
              "queryRef": "funnel_wide_export.is_purchased",
              "nativeQueryRef": "is_purchased"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}
